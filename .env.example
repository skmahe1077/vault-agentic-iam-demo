# Copy to .env (gitignored) and fill in before `terraform apply` (orders-db is
# RDS now -- also export as TF_VAR_orders_db_admin_password, see README.md).
ORDERS_DB_ADMIN_PASSWORD=

# Vault itself is HCP Vault Dedicated, provisioned by terraform/hcp.tf -- these
# aren't read by Terraform or docker, just `export` them in the shell before
# running vault-config/*.sh or agent/secure/run.sh. See "Running against HCP
# Vault Dedicated" in README.md.
#   export VAULT_ADDR="$(terraform -chdir=terraform output -raw vault_public_endpoint_url)"
#   export VAULT_NAMESPACE=admin
#   export VAULT_TOKEN=<token from `vault login` against the HCP cluster>
