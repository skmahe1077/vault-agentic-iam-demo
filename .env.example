# Copy to .env (gitignored) and fill in before `docker compose up -d`.
ORDERS_DB_ADMIN_PASSWORD=

# Vault itself is HCP Vault Dedicated, not a docker-compose service -- these
# aren't read by docker-compose, so don't put them in this file. Just
# `export` them in the shell before running vault-config/*.sh or
# agent/secure/run.sh. See "Running against HCP Vault Dedicated" in README.md.
#   export VAULT_ADDR=https://<cluster-id>.vault.<region>.aws.hashicorp.cloud:8200
#   export VAULT_NAMESPACE=admin
#   export VAULT_TOKEN=<token from `vault login` against the HCP cluster>
